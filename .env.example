# Leave model settings blank to use explicitly labelled RSS excerpt mode.
# Supply a base URL ending in /v1 (or the provider's equivalent), not /chat/completions.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=35
FEED_TIMEOUT=15

# Always Asia/Shanghai for this MVP. Times are a trigger, not a guaranteed finish.
REPORT_HOUR=8
REPORT_MINUTE=0
# Each region x category: up to 10 important items, 80 total per report.
MAX_PER_SECTION=10
CANDIDATE_MULTIPLIER=2

# Optional local operator token. Never commit this or a real AI key.
ADMIN_TOKEN=

# Web / account settings. Bind to LAN only when needed for phone testing.
WEB_BIND_ADDRESS=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
COOKIE_SECURE=false
SESSION_DAYS=30
ALLOW_REGISTRATION=true
AUTH_RATE_LIMIT=12

# JPush: Master Secret stays on the server; AppKey must match the Android build.
PUSH_PROVIDER=disabled
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
PUSH_TIMEOUT=10
